.env
# =========================
# 
# 1. Python Environment
# 
# =========================

__pycache__/
*.py[cod]
*$py.class
*.so
venv/
env/
re_env/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# =========================
# 
# 2. Project Data & Outputs
# 
# =========================
# 
# Ignore all files in the input and output directories

data/input/*
data/output/*
data/reference/*

# Keep the directories themselves in git (by tracking a hidden .gitkeep file)

!data/input/.gitkeep
!data/output/.gitkeep
!data/reference/.gitkeep

# Ignore generated/historical reference files
# 
# (You may want to track master_accounts.json if it's considered source code,
# 
# but ignore the auto-generated ones and the memory bank)

data/reference/match_history.json
data/reference/master_list_json.json
data/reference/master_accounts.xlsx

# =========================
# 
# 3. Environment & Secrets
# 
# =========================

.env
.env.local
.env.*
*.pem

# =========================
# 
# 4. OS & Editor Configs
# 
# =========================

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp

# Reports & Documentation
code_review_report.md
UI_CONFIGURATION_LOGIC.md
AI_PAIRING_INSTRUCTIONS.md
USER_DRIVEN_INGESTION_PLAN.md
